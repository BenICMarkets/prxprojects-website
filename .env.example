# Formspree form ID (formspree.io/f/<ID>) for the quote form
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id

# Set to true in Vercel PRODUCTION only when the site is ready to be indexed.
# Leave unset for previews and local builds (site stays noindex).
SITE_INDEXABLE=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Nothing loads if empty.
NEXT_PUBLIC_GA_ID=
